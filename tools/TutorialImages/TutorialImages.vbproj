<Project Sdk="Microsoft.NET.Sdk">

  <!--
    產生使用手冊的教學圖：用 AutoComposite.Core 跑一遍「載入 → 去背 → 自動定位 → 自動融合 → 匯出」，
    每一步存一張 PNG。去背模型由命令列指定（不放進 git）。
    用法：dotnet run（專案 tools/TutorialImages）並傳入 <背景.png> <人物.png> <模型.onnx> <輸出資料夾>
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TutorialImages</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AutoComposite.Core\AutoComposite.Core.vbproj" />
  </ItemGroup>

</Project>
